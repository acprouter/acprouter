{
  "name": "@acprouter/cli",
  "description": "ACP Router local bridge — dials out to a Router and puts this machine's agents on the network.",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "acprouter": "./bin/acprouter.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome format . --write && biome check . --write",
    "lint:err": "biome format . --write && biome check . --write --diagnostic-level=error",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "commander": "^14.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@acprouter/contract": "workspace:*",
    "@acprouter/core": "workspace:*",
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acprouter/acprouter.git",
    "directory": "apps/acprouter-cli"
  }
}
