# Copy this file to apps/acprouter/.env and fill it in before running
# `docker compose -f apps/acprouter/docker-compose.yml --env-file apps/acprouter/.env up --build`.
# See README.md "Deploying it for real" for the full walkthrough.

# Postgres password for the `acprouter` role/database created by the
# postgres service. Pick a real one for anything beyond a local try-out.
POSTGRES_PASSWORD=acprouter

# Basic-auth username the reverse proxy (Caddy) will require.
CADDY_BASIC_AUTH_USER=admin

# Bcrypt hash of the basic-auth password — NOT the plaintext password.
# Generate one with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<your password>'
# then paste the resulting hash here (keep it quoted if it contains `$`
# characters that your shell would otherwise try to expand).
CADDY_BASIC_AUTH_HASH='$2a$14$replace-me-with-a-real-bcrypt-hash'

# Host port the proxy publishes. Change if 18089 collides with something
# else already running on your machine.
ACPROUTER_PROXY_PORT=18089
