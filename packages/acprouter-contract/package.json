{
  "name": "@acprouter/contract",
  "description": "Client-safe ACP Router surface: oRPC contract + pure-zod DTO/VO schemas. No @orpc/server, no db/logic deps — consumed by the Router server and any consumer client.",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome format . --write && biome check . --write",
    "lint:err": "biome format . --write && biome check . --write --diagnostic-level=error",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@orpc/contract": "^1.14.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acprouter/acprouter.git",
    "directory": "packages/acprouter-contract"
  }
}
