{
  "name": "@acprouter/core",
  "description": "ACP Router shared server logic: ACP client/agent layer, registry sync, machine/session state machines, oRPC router. Consumed by the Router server and any other deployment built on the same schema.",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    },
    "./db/schema": {
      "types": "./src/db/schema.ts",
      "default": "./src/db/schema.ts"
    },
    "./acp-ws-stream": {
      "types": "./src/domains/agents/logic/acp-ws-stream.ts",
      "default": "./src/domains/agents/logic/acp-ws-stream.ts"
    },
    "./ws-keepalive": {
      "types": "./src/domains/agents/logic/ws-keepalive.ts",
      "default": "./src/domains/agents/logic/ws-keepalive.ts"
    },
    "./registry-sync": {
      "types": "./src/domains/agents/logic/registry-sync.ts",
      "default": "./src/domains/agents/logic/registry-sync.ts"
    },
    "./agents-client": {
      "types": "./src/domains/agents/client.tsx",
      "default": "./src/domains/agents/client.tsx"
    },
    "./agents-ui": {
      "types": "./src/domains/agents/components/agents-page-client.tsx",
      "default": "./src/domains/agents/components/agents-page-client.tsx"
    },
    "./agents-ui/add-agent-dialog": {
      "types": "./src/domains/agents/components/add-agent-dialog.tsx",
      "default": "./src/domains/agents/components/add-agent-dialog.tsx"
    },
    "./agents-ui/add-remote-agent-dialog": {
      "types": "./src/domains/agents/components/add-remote-agent-dialog.tsx",
      "default": "./src/domains/agents/components/add-remote-agent-dialog.tsx"
    },
    "./agents-ui/agent-catalog-grid": {
      "types": "./src/domains/agents/components/agent-catalog-grid.tsx",
      "default": "./src/domains/agents/components/agent-catalog-grid.tsx"
    },
    "./agents-ui/agent-session-sheet": {
      "types": "./src/domains/agents/components/agent-session-sheet.tsx",
      "default": "./src/domains/agents/components/agent-session-sheet.tsx"
    },
    "./agents-ui/agent-session-transcript": {
      "types": "./src/domains/agents/components/agent-session-transcript.tsx",
      "default": "./src/domains/agents/components/agent-session-transcript.tsx"
    },
    "./agents-ui/agent-status-indicator": {
      "types": "./src/domains/agents/components/agent-status-indicator.tsx",
      "default": "./src/domains/agents/components/agent-status-indicator.tsx"
    },
    "./agents-ui/consumer-connection-dialog": {
      "types": "./src/domains/agents/components/consumer-connection-dialog.tsx",
      "default": "./src/domains/agents/components/consumer-connection-dialog.tsx"
    },
    "./agents-ui/machines-list": {
      "types": "./src/domains/agents/components/machines-list.tsx",
      "default": "./src/domains/agents/components/machines-list.tsx"
    },
    "./agents-ui/registered-agents-list": {
      "types": "./src/domains/agents/components/registered-agents-list.tsx",
      "default": "./src/domains/agents/components/registered-agents-list.tsx"
    },
    "./agents-ui/use-agent-session": {
      "types": "./src/domains/agents/hooks/use-agent-session.ts",
      "default": "./src/domains/agents/hooks/use-agent-session.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome format . --write && biome check . --write",
    "lint:err": "biome format . --write && biome check . --write --diagnostic-level=error",
    "test": "vitest run"
  },
  "dependencies": {
    "@acprouter/contract": "workspace:*",
    "@agentclientprotocol/sdk": "1.3.0",
    "@electric-sql/pglite": "^0.3.15",
    "@orpc/client": "^1.14.6",
    "@orpc/contract": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "drizzle-orm": "^0.45.1",
    "kui": "workspace:*",
    "openlib": "workspace:*",
    "postgres": "^3.4.6",
    "react": "^19.2.7",
    "server-only": "^0.0.1",
    "ws": "^8.18.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acprouter/acprouter.git",
    "directory": "packages/acprouter-core"
  }
}
